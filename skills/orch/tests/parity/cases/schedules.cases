# Phase 5 parity: schedules. Each line runs on a fresh seeded home. Fixed expressions only, so the output is stable.
schedule
schedule list
schedule list --json
schedule show no-such
schedule enable no-such
schedule disable no-such
schedule remove no-such
schedule run no-such
schedule log no-such
schedule next
schedule next "not a cron"
schedule next "61 * * * *"
schedule next "* * * * * *"
schedule add --name n --cron "0 9 * * 1-5"
schedule add --name n --cron "0 9 * * *" --prompt hi --command true
schedule add --name n --cron "0 9 * * *" --prompt hi
schedule add --name n --cron "bad" --command true
schedule add --name n --cron "0 9 * * *" --command true --model m
schedule add --name n --cron "0 9 * * *" --command true --timeout 5x
schedule add --name n --cron "0 9 * * *" --command true --workdir /no/such/dir
schedule add --name n --cron "0 9 * * *" --command true --bogus x
schedule edit no-such --name x
schedule edit
