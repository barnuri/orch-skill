# Parity: run wait, run carry, use. Each line runs on a home holding run fx-run (fixtures/node-base.jsonl).
# fixture: fx-run node-base.jsonl
run wait
run wait nope
run wait fx-run --timeout x
run wait fx-run --stall-min 0
run wait fx-run --bogus
run carry
run carry nope
run carry fx-run --bogus
use
use nope
use ..
