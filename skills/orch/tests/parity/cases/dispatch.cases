# Phase 2 parity: node dispatch, node retry, run finish. No case starts a job (no real harness): error paths,
# --no-dispatch and finish only.
# fixture: fx-run node-base.jsonl
run finish fx-run
run finish fx-run --status error
run finish fx-run --status cancelled
run finish fx-run --status bogus
run finish fx-run --weird
run finish nope
run finish
node dispatch fx-run n1
node dispatch fx-run
node dispatch nope n1 claude "x"
node dispatch fx-run ghost claude "x"
node retry fx-run n1
node retry fx-run n1 --no-dispatch
node retry fx-run ghost
node retry fx-run n1 --weird
node retry fx-run n1 "a" "b"
node retry nope n1
node retry fx-run
