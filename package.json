{
  "name": "orch",
  "private": true,
  "type": "module",
  "description": "orch dashboard server and client. The skill itself (skills/orch) needs none of this to run the CLI.",
  "scripts": {
    "test": "ORCH_HERDR=0 bun scripts/heavy-test-lock.ts run -- bun test --timeout 300000 --parallel=6 --retry=1 --timings=${TMPDIR:-/tmp}/orch-bun-test-timings.json --update-timings src",
    "test:fast": "bun scripts/test-fast.ts",
    "test:budget": "bun scripts/test-budget.ts",
    "test:resume": "bun scripts/test-budget.ts --resume",
    "test:random": "ORCH_HERDR=0 bun test --timeout 300000 --parallel=6 --randomize src",
    "test:changed": "ORCH_HERDR=0 bun test --timeout 300000 --parallel=6 --changed src",
    "test:bench": "bun scripts/test-bench.ts",
    "test:orch:spawn": "ORCH_TEST_SPAWN=1 bun skills/orch/tests/run.ts",
    "test:orch": "bun skills/orch/tests/run.ts",
    "test:orch:changed": "bun skills/orch/tests/run.ts --changed",
    "test:orch:full": "bun skills/orch/tests/run.ts --full",
    "test:all": "bun scripts/test-all.ts",
    "test:all:changed": "bun scripts/test-all.ts --changed",
    "typecheck": "bun scripts/typecheck.ts",
    "format": "bunx oxfmt src",
    "format:check": "bunx oxfmt --check src",
    "lint": "bunx oxlint src",
    "check": "bun scripts/test-all.ts"
  },
  "dependencies": {
    "@barnuri/hono-decorators": "github:barnuri/hono-decorators",
    "@barnuri/zod-decorators": "github:barnuri/zod-decorators",
    "@hono/zod-openapi": "^1.6.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "1.4.4",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2"
  }
}
