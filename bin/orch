#!/usr/bin/env bun
// Global entrypoint for the orch CLI, installed to ~/.local/bin/orch by install.ts.
import { existsSync, realpathSync } from "node:fs";
import { dirname, join } from "node:path";

const repoRoot = join(dirname(realpathSync(import.meta.path)), "..");
const dispatch = join(repoRoot, "skills/orch/scripts/dispatch.ts");
if (!existsSync(dispatch)) {
  console.error(`orch: ${dispatch} missing — re-run install.ts from the orch-skill checkout`);
  process.exit(1);
}
const p = Bun.spawn([process.execPath, dispatch, ...process.argv.slice(2)], { stdin: "inherit", stdout: "inherit", stderr: "inherit" });
process.exit(await p.exited);
