# Typecheck symlink farm — populated from bun's global install cache, never committed.
.types/

# Editor / OS noise
.DS_Store
*.swp

# Dependencies and build output
node_modules/
node_modules
dist/

# Browser-automation artifacts
.playwright-mcp/
.playwright-cli/

# Agent session scratch
**/agent-spec

# Convenience symlink to the live state directory (~/.harness-orch): profiles.json, serve.json,
# memory.json, runs/, jobs/. Per-machine and absolute — created by install.ts, never committed.
# .vscode/settings.json sets explorer.excludeGitIgnore so ./config still shows in the editor.
/config
mods/*/.claude-plugin/types/
mods/*/tsconfig.json
__pycache__/
*.pyc

*.log

# Personal profile overlay (llm-hub, local models, smart-auto): merged over templates/profiles.json, never committed.
skills/orch/templates/profiles.local.json
